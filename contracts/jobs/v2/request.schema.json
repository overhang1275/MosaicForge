{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DurableJobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "generation",
    "requestedAcceptedCount",
    "maxCandidates",
    "pdf",
    "execution",
    "projectRevision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["2"]
    },
    "projectId": {
      "$ref": "../v1/common.schema.json#/definitions/Id"
    },
    "generation": {
      "$ref": "../../engine/v1/generation.schema.json"
    },
    "requestedAcceptedCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "maxCandidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "pdf": {
      "$ref": "../../engine/pdf/v1/job.schema.json#/properties/pdf"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockSize", "concurrency"],
      "properties": {
        "blockSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
