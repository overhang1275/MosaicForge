{
  "$ref": "#/definitions/ProjectListResponse",
  "definitions": {
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "currentRevision": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "currentRevision",
        "createdAt",
        "updatedAt"
      ],
      "title": "Project",
      "type": "object"
    },
    "ProjectListResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "nextCursor": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "projects": {
          "items": {
            "$ref": "#/definitions/Project"
          },
          "maxItems": 100,
          "type": "array"
        },
        "requestId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1"
          ],
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "projects",
        "nextCursor"
      ],
      "title": "ProjectListResponse",
      "type": "object"
    }
  }
}
