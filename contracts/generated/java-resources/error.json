{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "code": {
      "$ref": "#/definitions/Ref0"
    },
    "message": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "requestId": {
      "$ref": "#/definitions/RequestId"
    }
  },
  "required": [
    "requestId",
    "code",
    "message"
  ],
  "title": "PreviewError",
  "type": "object",
  "definitions": {
    "Ref0": {
      "enum": [
        "invalid_request",
        "invalid_template",
        "unauthorized",
        "forbidden",
        "payload_too_large",
        "unsupported_media_type",
        "busy",
        "internal_error",
        "engine_unavailable",
        "timeout"
      ],
      "type": "string"
    },
    "RequestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "RequestId",
      "type": "string"
    }
  }
}
