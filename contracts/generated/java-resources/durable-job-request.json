{
  "$ref": "#/definitions/DurableJobRequest",
  "definitions": {
    "Ref2": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "pattern": "^(transparent|#[0-9a-fA-F]{6})$",
          "type": "string"
        },
        "format": {
          "enum": [
            "svg",
            "png"
          ],
          "type": "string"
        },
        "height": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "format",
        "width",
        "height",
        "background"
      ],
      "type": "object"
    },
    "Ref4": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "Ref5": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "Ref3": {
      "additionalProperties": false,
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref4"
            },
            {
              "type": "null"
            }
          ]
        },
        "distortion": {
          "minimum": 0,
          "type": "number"
        },
        "mirrorX": {
          "type": "boolean"
        },
        "mirrorY": {
          "type": "boolean"
        },
        "opacity": {
          "$ref": "#/definitions/Ref5"
        },
        "palette": {
          "items": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        },
        "preserveAspectRatio": {
          "description": "Rules v2 requires an explicit flag. When true, scaleX and scaleY ranges must match and share one sampled factor. Forbidden in rules v1.",
          "type": "boolean"
        },
        "rotationDegrees": {
          "$ref": "#/definitions/Ref5"
        },
        "scaleX": {
          "$ref": "#/definitions/Ref5"
        },
        "scaleY": {
          "$ref": "#/definitions/Ref5"
        },
        "shuffleLayers": {
          "type": "boolean"
        },
        "translateX": {
          "$ref": "#/definitions/Ref5"
        },
        "translateY": {
          "$ref": "#/definitions/Ref5"
        }
      },
      "required": [
        "translateX",
        "translateY",
        "rotationDegrees",
        "scaleX",
        "scaleY",
        "mirrorX",
        "mirrorY",
        "opacity",
        "shuffleLayers",
        "distortion"
      ],
      "type": "object"
    },
    "Ref6": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "Ref7": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "GenerationSpec": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "count": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "engineVersion": {
          "enum": [
            "0.1.0"
          ],
          "type": "string"
        },
        "output": {
          "$ref": "#/definitions/Ref2"
        },
        "rules": {
          "$ref": "#/definitions/Ref3"
        },
        "rulesVersion": {
          "enum": [
            "1",
            "2",
            "3"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1"
          ],
          "type": "string"
        },
        "seed": {
          "$ref": "#/definitions/Ref6"
        },
        "startIndex": {
          "$ref": "#/definitions/Ref6"
        },
        "templateHash": {
          "$ref": "#/definitions/Ref7"
        }
      },
      "required": [
        "schemaVersion",
        "templateHash",
        "seed",
        "startIndex",
        "count",
        "engineVersion",
        "rulesVersion",
        "rules",
        "output"
      ],
      "title": "GenerationSpec",
      "type": "object"
    },
    "PdfLayout": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "bleedMm": {
          "maximum": 50,
          "minimum": 0,
          "type": "number"
        },
        "exporterVersion": {
          "enum": [
            "1"
          ],
          "type": "string"
        },
        "trimHeightMm": {
          "maximum": 2000,
          "minimum": 1,
          "type": "number"
        },
        "trimWidthMm": {
          "maximum": 2000,
          "minimum": 1,
          "type": "number"
        }
      },
      "required": [
        "exporterVersion",
        "trimWidthMm",
        "trimHeightMm",
        "bleedMm"
      ],
      "title": "PdfLayout",
      "type": "object"
    },
    "Ref9": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "DurableJobRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "execution": {
          "additionalProperties": false,
          "properties": {
            "blockSize": {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            "concurrency": {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "blockSize",
            "concurrency"
          ],
          "type": "object"
        },
        "generation": {
          "$ref": "#/definitions/GenerationSpec"
        },
        "maxCandidates": {
          "maximum": 10000000,
          "minimum": 1,
          "type": "integer"
        },
        "pdf": {
          "$ref": "#/definitions/PdfLayout"
        },
        "projectId": {
          "$ref": "#/definitions/Ref9"
        },
        "projectRevision": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "requestedAcceptedCount": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "schemaVersion": {
          "enum": [
            "2"
          ],
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "generation",
        "requestedAcceptedCount",
        "maxCandidates",
        "pdf",
        "execution",
        "projectRevision"
      ],
      "title": "DurableJobRequest",
      "type": "object"
    }
  }
}
