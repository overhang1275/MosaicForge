{
  "$ref": "#/definitions/ProjectResponse",
  "definitions": {
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "currentRevision": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "currentRevision",
        "createdAt",
        "updatedAt"
      ],
      "title": "Project",
      "type": "object"
    },
    "ProjectResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "#/definitions/Project"
        },
        "requestId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1"
          ],
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "project"
      ],
      "title": "ProjectResponse",
      "type": "object"
    }
  }
}
