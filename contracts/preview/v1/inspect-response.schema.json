{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InspectResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "templateHash",
    "width",
    "height",
    "viewBox",
    "layerIds",
    "segmentCount",
    "engineVersion",
    "rulesVersion"
  ],
  "properties": {
    "requestId": {
      "$ref": "common.schema.json#/definitions/RequestId"
    },
    "templateHash": {
      "$ref": "../../engine/v1/generation.schema.json#/definitions/Hash"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "viewBox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "layerIds": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "segmentCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "engineVersion": {
      "type": "string",
      "enum": [
        "0.1.0"
      ]
    },
    "rulesVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    }
  }
}
