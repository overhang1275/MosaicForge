{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelectedPdfExportRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "templateSvg",
    "job",
    "variantIndices"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["2"] },
    "requestId": { "$ref": "../v1/common.schema.json#/definitions/RequestId" },
    "templateSvg": { "type": "string", "minLength": 1, "maxLength": 5242880 },
    "job": { "$ref": "../../engine/pdf/v1/job.schema.json" },
    "variantIndices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" }
    }
  }
}
