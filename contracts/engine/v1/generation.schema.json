{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenerationSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateHash",
    "seed",
    "startIndex",
    "count",
    "engineVersion",
    "rulesVersion",
    "rules",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "templateHash": {
      "$ref": "#/definitions/Hash"
    },
    "seed": {
      "$ref": "#/definitions/DecimalU64"
    },
    "startIndex": {
      "$ref": "#/definitions/DecimalU64"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "engineVersion": {
      "type": "string",
      "enum": [
        "0.1.0"
      ]
    },
    "rulesVersion": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ]
    },
    "rules": {
      "$ref": "#/definitions/Rules"
    },
    "output": {
      "$ref": "#/definitions/OutputSpec"
    }
  },
  "definitions": {
    "DecimalU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "Crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "OutputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "width",
        "height",
        "background"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "svg",
            "png"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "background": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{6})$"
        }
      }
    },
    "Rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translateX",
        "translateY",
        "rotationDegrees",
        "scaleX",
        "scaleY",
        "mirrorX",
        "mirrorY",
        "opacity",
        "shuffleLayers",
        "distortion"
      ],
      "properties": {
        "translateX": {
          "$ref": "#/definitions/Range"
        },
        "translateY": {
          "$ref": "#/definitions/Range"
        },
        "rotationDegrees": {
          "$ref": "#/definitions/Range"
        },
        "scaleX": {
          "$ref": "#/definitions/Range"
        },
        "scaleY": {
          "$ref": "#/definitions/Range"
        },
        "preserveAspectRatio": {
          "type": "boolean",
          "description": "Rules v2 requires an explicit flag. When true, scaleX and scaleY ranges must match and share one sampled factor. Forbidden in rules v1."
        },
        "mirrorX": {
          "type": "boolean"
        },
        "mirrorY": {
          "type": "boolean"
        },
        "opacity": {
          "$ref": "#/definitions/Range"
        },
        "palette": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "shuffleLayers": {
          "type": "boolean"
        },
        "distortion": {
          "type": "number",
          "minimum": 0
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/definitions/Crop"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
