{
  "name": "mosaicforge-contract-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "generate": "node generate.mjs",
    "check": "node generate.mjs --check",
    "test": "node --test contract.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check \"*.mjs\" \"*.json\" \"*.ts\""
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.8.1",
    "typescript": "7.0.2"
  }
}
